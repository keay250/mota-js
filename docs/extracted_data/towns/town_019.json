    {
      "event_id": 4,
      "name": "EV004",
      "x": 14,
      "y": 29,
      "character": "",
      "dialogue_tree": [
        {
          "page": 0,
          "condition": {
            "switch1": null,
            "switch2": null,
            "variable": null,
            "self_switch": null
          },
          "text": "青年佣兵：\n我跟你说，\n我家里祖上出过一位大人物！\n另一个青年佣兵：\n什么大人物？\n青年佣兵：\n哼哼，说出来怕吓到你，\n那可是一位职业者！\n另一个青年佣兵：\n妈的智障，你当我傻吗？\n职业者那么尊贵的存在怎\n么可能会定居厄泽城。\n青年佣兵：\n这个嘛……其中肯定是有原因的。\n反正我太爷爷的日记里是这么写的。\n另一个青年佣兵：\n你太爷爷是干啥的？\n也是佣兵吗？\n青年佣兵：\n不，我太爷爷是写笑话故事集的。\n另一个青年佣兵：\n………………",
          "choices": [

          ]
        }
      ]
    },
    {
      "event_id": 5,
      "name": "重甲佣兵",
      "x": 17,
      "y": 32,
      "character": "014-Warrior02",
      "dialogue_tree": [
