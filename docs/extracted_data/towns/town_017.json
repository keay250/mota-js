    {
      "event_id": 23,
      "name": "商人",
      "x": 55,
      "y": 13,
      "character": "112-Civilian12",
      "dialogue_tree": [
        {
          "page": 0,
          "condition": {
            "switch1": null,
            "switch2": null,
            "variable": null,
            "self_switch": null
          },
          "text": "商人：\n真是见了鬼了，\n刚来这座小城就碰上这种破事。\n商人：\n本来想投资开垦下城外森林外围区域，\n结果……哎，真是倒霉。\n商人：\n希望全能之神能够保佑接下来回\n去的路上别再出什么岔子了……\n商人：\n从上方的港口乘船沿姆伊森运\n河行驶上十来天就可以抵达普\n利斯特王都了。",
          "choices": [

          ]
        }
      ]
    },
